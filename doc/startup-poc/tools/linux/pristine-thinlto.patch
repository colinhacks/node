+def linux_clang_20_or_newer():
+  version_checked = (20, 1, 0)
+  for compiler, language in ((CC, 'c'), (CXX, 'c++')):
+    available, is_clang, clang_version, _1, _2 = (
+      try_check_compiler(compiler, language)
+    )
+    if not available or not is_clang or clang_version < version_checked:
+      return False
+  return True
+
+
+def linux_lld_works():
+  try:
+    result = subprocess.run(
+      shlex.split(CXX) + ['-fuse-ld=lld', '-x', 'c++', '-', '-o', os.devnull],
+      input=b'int main() { return 0; }', stdout=subprocess.PIPE,
+      stderr=subprocess.PIPE, check=False)
+  except OSError:
+    return False
+  return result.returncode == 0
+
