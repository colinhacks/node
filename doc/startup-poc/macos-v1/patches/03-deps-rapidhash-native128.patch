index 00000000..0a66cf60
--- /dev/null
+++ b/test/cctest/test_hash_secret.cc
@@ -0,0 +1,84 @@
+#include <cstdint>
+#include <iterator>
+
+#include "third_party/rapidhash-v8/secret.h"
+
+#include "gtest/gtest.h"
+
+#if !V8_USE_DEFAULT_HASHER_SECRET
+namespace {
+
+struct MulModCase {
+  uint64_t a;
+  uint64_t b;
+  uint64_t modulus;
+  uint64_t expected;
+};
+
+TEST(RapidhashSecret, ModularMultiplication) {
+  constexpr MulModCase cases[] = {
+      {UINT64_C(0x0000000000000000), UINT64_C(0x0000000000000000),
+       UINT64_C(0x0000000000000001), UINT64_C(0x0000000000000000)},
+      {UINT64_C(0x0000000000000001), UINT64_C(0xffffffffffffffff),
+       UINT64_C(0x0000000000000002), UINT64_C(0x0000000000000001)},
+      {UINT64_C(0x0000000000000002), UINT64_C(0xffffffffffffffff),
+       UINT64_C(0x0000000000000003), UINT64_C(0x0000000000000000)},
+      {UINT64_C(0xfffffffffffffffe), UINT64_C(0xffffffffffffffff),
+       UINT64_C(0xffffffffffffffff), UINT64_C(0x0000000000000000)},
+      {UINT64_C(0xffffffffffffffc4), UINT64_C(0xfffffffffffffffd),
+       UINT64_C(0xffffffffffffffc5), UINT64_C(0xffffffffffffff8d)},
+      {UINT64_C(0x8000000000000000), UINT64_C(0x8000000000000000),
+       UINT64_C(0xffffffffffffffff), UINT64_C(0x4000000000000000)},
+      {UINT64_C(0x8000000000000000), UINT64_C(0xffffffffffffffff),
+       UINT64_C(0x8000000000000001), UINT64_C(0x0000000000000003)},
+      {UINT64_C(0x8000000000000000), UINT64_C(0xfffffffffffffffe),
+       UINT64_C(0x8000000000000001), UINT64_C(0x0000000000000004)},
+  };
+
+  for (const MulModCase& test : cases) {
+    EXPECT_EQ(detail::mul_mod(test.a, test.b, test.modulus), test.expected);
+  }
+}
+
+struct SecretCase {
+  uint64_t seed;
+  uint64_t secret[3];
+};
+
+TEST(RapidhashSecret, GeneratedSecrets) {
+  // These golden vectors were generated by the pre-optimization helper.
+  constexpr SecretCase cases[] = {
+      {UINT64_C(0x0000000000000000),
+       {UINT64_C(0x39d43c5c4e3a724b), UINT64_C(0x6596e14753cca38b),
+        UINT64_C(0xc68d954b2b339353)}},
+      {UINT64_C(0x0000000000000001),
+       {UINT64_C(0x0ff09999359563a5), UINT64_C(0x2d6c35b48de81b2b),
+        UINT64_C(0xd2ca93c527b49c2b)}},
+      {UINT64_C(0xffffffffffffffff),
+       {UINT64_C(0x550fc6c5d4aa6a95), UINT64_C(0xd16ce139c6e1b44d),
+        UINT64_C(0xb239d83c653c4ec5)}},
+      {UINT64_C(0x8000000000000000),
+       {UINT64_C(0x2b939a965c748e1b), UINT64_C(0x1e17c569d2666a0f),
+        UINT64_C(0x742db1ca39c5ca53)}},
+      {UINT64_C(0x0123456789abcdef),
+       {UINT64_C(0x65962e71a35369c3), UINT64_C(0x369c5cd26927aa2d),
+        UINT64_C(0x53d82d4b5c5655a9)}},
+      {UINT64_C(0x000000000000002a),
+       {UINT64_C(0x8b4be21b934dc6a3), UINT64_C(0x9a0f72f0e81b6969),
+        UINT64_C(0x99746a47f066331b)}},
+      {UINT64_C(0xdeadbeefcafebabe),
+       {UINT64_C(0x1d6a55e1e41bccb1), UINT64_C(0x59668e723caa1b53),
+        UINT64_C(0x3a1eb893d4c9d1c5)}},
+  };
+
+  for (const SecretCase& test : cases) {
+    uint64_t secret[3];
+    rapidhash_make_secret(test.seed, secret);
+    for (size_t i = 0; i < std::size(secret); ++i) {
+      EXPECT_EQ(secret[i], test.secret[i]);
+    }
+  }
+}
+
+}  // namespace
+#endif  // !V8_USE_DEFAULT_HASHER_SECRET
