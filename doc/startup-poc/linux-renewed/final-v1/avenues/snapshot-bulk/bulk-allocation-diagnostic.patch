 template <typename IsolateT>
+void Deserializer<IsolateT>::AddBackReference(Handle<HeapObject> object) {
+  const size_t old_size = back_refs_.size();
+  const size_t old_capacity = back_refs_.capacity();
+  back_refs_.push_back(object);
+  if (V8_UNLIKELY(v8_flags.profile_deserialization) &&
+      back_refs_.capacity() != old_capacity) {
+    ++back_ref_reallocations_;
+    back_ref_relocated_entries_ += old_size;
+  }
+}
