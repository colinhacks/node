+#ifndef V8_SNAPSHOT_DESERIALIZATION_ALLOCATION_DIAGNOSTICS_H_
+#define V8_SNAPSHOT_DESERIALIZATION_ALLOCATION_DIAGNOSTICS_H_
+
+#include <atomic>
+#include <cstdint>
+
+namespace v8 {
+namespace internal {
+
+// Process-global diagnostic counters for --profile-deserialization. A caller
+// records start and end snapshots because deserializers may overlap.
+class SnapshotDeserializationAllocationDiagnostics final {
+ public:
+  struct Counters {
+    uint64_t main_allocator_slow_paths;
+    uint64_t paged_space_expansions;
+    uint64_t read_only_space_growths;
+  };
+
+  static Counters Get() {
+    return {
+        main_allocator_slow_paths_.load(std::memory_order_relaxed),
+        paged_space_expansions_.load(std::memory_order_relaxed),
+        read_only_space_growths_.load(std::memory_order_relaxed),
+    };
+  }
+
+  static Counters Subtract(Counters end, Counters start) {
+    return {
+        end.main_allocator_slow_paths - start.main_allocator_slow_paths,
+        end.paged_space_expansions - start.paged_space_expansions,
+        end.read_only_space_growths - start.read_only_space_growths,
+    };
+  }
+
+  static void RecordMainAllocatorSlowPath() {
+    main_allocator_slow_paths_.fetch_add(1, std::memory_order_relaxed);
+  }
+  static void RecordPagedSpaceExpansion() {
+    paged_space_expansions_.fetch_add(1, std::memory_order_relaxed);
+  }
+  static void RecordReadOnlySpaceGrowth() {
+    read_only_space_growths_.fetch_add(1, std::memory_order_relaxed);
+  }
+
+ private:
+  inline static std::atomic<uint64_t> main_allocator_slow_paths_{0};
+  inline static std::atomic<uint64_t> paged_space_expansions_{0};
+  inline static std::atomic<uint64_t> read_only_space_growths_{0};
+};
+
+}  // namespace internal
+}  // namespace v8
+
+#endif  // V8_SNAPSHOT_DESERIALIZATION_ALLOCATION_DIAGNOSTICS_H_
